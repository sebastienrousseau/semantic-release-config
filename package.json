{
  "name": "@sebastienrousseau/semantic-release-config",
  "version": "0.0.7",
  "description": "Shareable semantic-release configuration rules for automated releases",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/semantic-release-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/semantic-release-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/semantic-release-config/issues"
  },
  "keywords": [
    "semantic-release",
    "release",
    "automation",
    "changelog",
    "npm-publish"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "semantic-release-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/conformance.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh",
    "test:conformance": "node --test tests/conformance.test.js",
    "fuzz": "node fuzz/fuzz_config.js"
  },
  "peerDependencies": {
    "semantic-release": ">=23.0.0"
  },
  "devDependencies": {
    "@sebastienrousseau/config-kit": "^0.0.8",
    "semantic-release": "^25.0.9"
  },
  "overrides": {
    "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9 <6.0.0",
    "ip-address@<=10.3.0": ">=10.3.1 <11.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1"
  },
  "configKit": {
    "shape": "object",
    "presets": [],
    "validate": "semantic-release"
  }
}
