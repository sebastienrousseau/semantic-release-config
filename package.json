{
  "name": "@sebastienrousseau/semantic-release-config",
  "version": "0.0.5",
  "description": "Shareable semantic-release configuration rules for automated releases",
  "author": "Sebastien Rousseau <sebastienrousseau@users.noreply.github.com>",
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/sebastienrousseau/semantic-release-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienrousseau/semantic-release-config.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienrousseau/semantic-release-config/issues"
  },
  "keywords": [
    "semantic-release",
    "release",
    "automation",
    "changelog",
    "npm-publish"
  ],
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "semantic-release-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 tests/unit.test.js tests/integration.test.js tests/bench.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 tests/unit.test.js tests/integration.test.js tests/bench.test.js",
    "bench": "node benches/bench_load.js",
    "examples": "node examples/basic.js && node examples/advanced.js && node examples/features.js && node examples/esm.mjs",
    "docs:build": "bash scripts/build-docs.sh"
  },
  "peerDependencies": {
    "semantic-release": ">=23.0.0"
  },
  "devDependencies": {
    "semantic-release": "^25.0.9"
  },
  "overrides": {
    "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9 <6.0.0",
    "ip-address@<=10.3.0": ">=10.3.1 <11.0.0"
  }
}
