  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "index.d.ts",
    "semantic-release-config.svg",
    "LICENSE",
    ".editorconfig"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/test.js",
    "lint": "node test/test.js"
  },
  "peerDependencies": {
    "semantic-release": ">=23.0.0"
  },
  "devDependencies": {
    "semantic-release": "^23.0.0"
  }
}
